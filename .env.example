# Copy this file to .env and fill the values locally. Do not commit secrets.

# Copernicus Marine credentials
COPERNICUS_USER=
COPERNICUS_KEY=

# Backward-compatible aliases also supported by src.files_functions
# COPERNICUS_UID=
# COPERNICUS_API_TOKEN=

# ECMWF credentials, only needed by workflows that use authenticated ECMWF APIs
ECMWF_URL=
ECMWF_KEY=
ECMWF_EMAIL=