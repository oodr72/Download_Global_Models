# ============================================================
# Download_Global_Models - Environment Variables Template
# ============================================================
# Instructions:
# 1. Copy this file to `.env`:  cp .env.example .env
# 2. Fill in your credentials below
# 3. NEVER commit `.env` to git (it is in .gitignore)
# 4. For Copernicus, you also need:
#    python3 -c "import copernicusmarine; copernicusmarine.login(username='YOUR_USER', password='YOUR_KEY')"
#
# ============================================================
# COPENICUS MARINE (GLORYS + FMWAM)
# ============================================================
COPERNICUS_USER=
COPERNICUS_KEY=
COPERNICUS_UID=
COPERNICUS_API_TOKEN=

# ============================================================
# ECMWF OPEN DATA API
# ============================================================
ECMWF_URL=https://cds.climate.copernicus.eu/api/v2
ECMWF_KEY=
ECMWF_EMAIL=

# ============================================================
# NCSS/OPENDAP ENDPOINTS (Optional)
# ============================================================
# Set these if you have NCSS access for server-side subsetting
RTOFS_NCSS_DATASET=
HYCOM_NCSS_BASE=https://ncss.hycom.org/thredds/ncss
HYCOM_NCSS_DATASET=GLBy0.08/expt_93.0/analysis
